# ArrGuard configuration
# Copy to /etc/arrguard.conf and edit the values you need.

# auto | sonarr | radarr
APP="auto"

SONARR_URL="http://127.0.0.1:8989"
SONARR_API_KEY=""

RADARR_URL="http://127.0.0.1:7878"
RADARR_API_KEY=""

# Reject media smaller than this (MiB). Per-app values override the global one.
# TV is lower because short episodes, anime and cartoons are often < 100 MiB.
MIN_VIDEO_SIZE_MIB="100"
SONARR_MIN_VIDEO_SIZE_MIB="40"
RADARR_MIN_VIDEO_SIZE_MIB="100"

# Safety first: keep true until you verify logs.
# Only an explicit "false" (or 0/no) turns live mode on; anything else stays dry.
DRY_RUN="true"

# Checks
CHECK_SAMPLE="true"
CHECK_VIDEO_STREAM="true"
CHECK_ARCHIVES="true"
FFPROBE_TIMEOUT="60"

# Archives next to a missing/small video (e.g. an obfuscated RAR set the
# download client did not unpack).
#   skip    = leave it alone (use this if Unpackerr/the client still extracts)
#   extract = look inside + test it: extract when intact and it contains video,
#             reject when password-protected, corrupt, incomplete or no video
#             inside (needs unrar and/or 7z)
#   reject  = reject without testing (not recommended: good releases get removed)
ARCHIVE_ACTION="skip"
# Free space to keep on the download disk after extracting (MiB).
EXTRACT_MIN_FREE_MIB="1024"

# Skip downloads whose files changed within this many minutes (import,
# extraction or move may still be running). 0 disables.
MIN_AGE_MINUTES="10"

# Actions taken for a rejected queue item.
REMOVE_FROM_CLIENT="true"   # deletes the download AND its files in the client
BLOCKLIST="true"
SEARCH_AGAIN="true"         # Sonarr/Radarr search for a replacement (needs BLOCKLIST=true)

# If true, a completed queue item with no video is rejected.
REJECT_NO_VIDEO="true"

# Missing paths can indicate a path-mapping problem, so this is off by default.
REJECT_MISSING_PATH="false"

# Also inspect items in the client category that Sonarr/Radarr do not
# recognise. Off by default: they may not be media at all.
INCLUDE_UNKNOWN_ITEMS="false"

# Docker/container path mapping
# If Sonarr/Radarr reports a container path that differs from the host path,
# map it here. Separate multiple mappings with semicolons.
# Example:
# PATH_MAPPINGS="/downloads=/mnt/downloads;/media=/mnt/media"
PATH_MAPPINGS=""

# Logging
LOG_FILE="/var/log/arrguard.log"
LOCK_FILE="/run/lock/arrguard.lock"
